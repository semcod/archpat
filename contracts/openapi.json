            "maxItems": 50,
            "minItems": 1,
            "title": "Operations"
          },
          "constraints": {
            "$ref": "#/components/schemas/Constraints"
          },
          "weights": {
            "$ref": "#/components/schemas/Weights"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Assumptions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "actor",
          "goal",
          "acceptance_criteria",
          "operations"
        ],
        "title": "StorySpec"
      },
      "SynthesisResult": {
        "properties": {
          "schema_version": {
            "type": "string",
