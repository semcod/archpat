        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "selected_id",
          "pareto_ids",
          "input_sha256",
          "assumptions",
          "candidates"
        ],
        "title": "SynthesisResult"
      },
      "TemporalRequirement": {
