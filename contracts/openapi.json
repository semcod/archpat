        "additionalProperties": false,
        "type": "object",
        "required": [
          "project",
          "path"
        ],
        "title": "ReuseEvidence"
      },
      "StorySpec": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "archpat.story/v1",
            "title": "Schema Version",
            "default": "archpat.story/v1"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Title"
          },
          "actor": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Actor"
          },
          "goal": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Goal"
          },
          "acceptance_criteria": {
            "items": {
              "type": "string",
              "maxLength": 8000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Acceptance Criteria"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/OperationSpec"
            },
