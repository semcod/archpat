          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "capability",
          "aggregate"
        ],
        "title": "OperationSpec"
      },
      "ReuseEvidence": {
        "properties": {
          "project": {
            "type": "string",
            "title": "Project"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "symbols": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Symbols"
          },
          "source_sha256": {
            "anyOf": [
