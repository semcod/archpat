          },
          "selected_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Id"
          },
          "pareto_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pareto Ids"
          },
          "input_sha256": {
            "type": "string",
            "title": "Input Sha256"
          },
          "search_scope": {
            "type": "string",
            "const": "three_explicit_cqrs_es_templates",
            "title": "Search Scope",
            "default": "three_explicit_cqrs_es_templates"
          },
          "objective_definition": {
            "type": "string",
            "title": "Objective Definition",
            "default": "weighted_normalized_priors_v1; smaller is better"
          },
          "execution_ready": {
            "type": "boolean",
            "const": false,
            "title": "Execution Ready",
            "default": false
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assumptions"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          }
