{
  "$defs": {
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "ram_budget_mb": {
          "default": 4096,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Ram Budget Mb",
          "type": "integer"
        },
        "reserved_ram_mb": {
          "default": 0,
          "maximum": 1048576,
          "minimum": 0,
          "title": "Reserved Ram Mb",
          "type": "integer"
        },
        "max_processes": {
          "default": 3,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Processes",
          "type": "integer"
        },
        "isolate_projection": {
          "default": false,
          "title": "Isolate Projection",
          "type": "boolean"
        },
        "independent_command_query_scaling": {
          "default": false,
          "title": "Independent Command Query Scaling",
          "type": "boolean"
        },
        "offline": {
          "default": true,
          "title": "Offline",
          "type": "boolean"
        },
        "interfaces": {
          "items": {
            "enum": [
              "rest",
              "mcp",
              "shell"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Interfaces",
          "type": "array"
        },
        "artifact_formats": {
          "items": {
            "enum": [
              "json",
              "protobuf"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Artifact Formats",
          "type": "array"
        },
        "required_patterns": {
          "items": {
            "enum": [
              "cqrs",
              "event_sourcing",
              "outbox",
              "ports_adapters"
            ],
            "type": "string"
          },
          "title": "Required Patterns",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "OperationSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "command",
            "query"
          ],
          "title": "Kind",
          "type": "string"
        },
        "capability": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Capability",
          "type": "string"
        },
        "aggregate": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Aggregate",
          "type": "string"
        },
        "input_urns": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Input Urns",
          "type": "array"
        },
        "output_urns": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Output Urns",
          "type": "array"
        },
        "consistency": {
          "default": "eventual",
          "enum": [
            "eventual",
            "read_your_writes"
          ],
          "title": "Consistency",
          "type": "string"
        },
        "temporal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalRequirement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "capability",
        "aggregate"
      ],
      "title": "OperationSpec",
      "type": "object"
    },
    "TemporalRequirement": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "timezone": {
          "default": "Europe/Warsaw",
          "title": "Timezone",
          "type": "string"
        },
        "resolution_status": {
          "const": "unresolved",
          "default": "unresolved",
          "title": "Resolution Status",
          "type": "string"
        },
        "owner": {
          "const": "uritime",
          "default": "uritime",
          "title": "Owner",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TemporalRequirement",
      "type": "object"
    },
    "Weights": {
      "additionalProperties": false,
      "properties": {
        "ram": {
          "default": 0.35,
          "maximum": 1,
          "minimum": 0,
          "title": "Ram",
          "type": "number"
        },
        "processes": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Processes",
          "type": "number"
        },
        "coupling": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Coupling",
          "type": "number"
        },
        "change_surface": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Change Surface",
          "type": "number"
        }
      },
      "title": "Weights",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "archpat.story/v1",
      "default": "archpat.story/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "actor": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "goal": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "acceptance_criteria": {
      "items": {
        "maxLength": 8000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/OperationSpec"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "weights": {
      "$ref": "#/$defs/Weights"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "actor",
    "goal",
    "acceptance_criteria",
    "operations"
  ],
  "title": "StorySpec",
  "type": "object"
}
